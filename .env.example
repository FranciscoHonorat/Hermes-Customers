# --- customers ---
PORT=8080
DATABASE_DSN=mundo_invest.db

# Integração Pipefy (deixe vazio para modo simulado)
PIPEFY_API_TOKEN=
PIPEFY_PIPE_ID=

# RabbitMQ (deixe vazio para publicar em modo noop/simulado)
RABBITMQ_URI=

# Segurança (deixe vazio roda sem proteção — só recomendado em desenvolvimento
# local; um WARN é logado no boot quando ausente)
API_AUTH_TOKEN=
PIPEFY_WEBHOOK_SECRET=

# --- api-gateway ---
# PORT: mesma variável do customers acima — como são processos separados,
# rode cada serviço com seu próprio .env (ou defina PORT=8000 só no ambiente
# do gateway) para não colidirem.
PORT=8000
CUSTOMERS_SERVICE_URL=http://localhost:8080

# Lista separada por vírgula das origens autorizadas a fazer requisições
# cross-origin; vazio = nenhum cabeçalho CORS é enviado
ALLOWED_ORIGINS=

# Rate limiting por IP (token bucket)
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20
